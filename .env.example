# ==============================================================================
# ThreatLens Environment Configuration
# ==============================================================================

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PORT=9092
KAFKA_FLOW_TOPIC=network-flows
KAFKA_ALERT_TOPIC=threat-alerts

# Ingestion Source
# synthetic = demo generator publishing into Kafka network-flows (same pipeline as real traffic)
# kafka    = external Zeek shipper publishes to network-flows; no synthetic events
INGEST_SOURCE=synthetic
# Set false to disable all background Kafka workers (tests / offline dev)
ENABLE_BACKGROUND_GENERATOR=true

# Redis Configuration (Sliding Window Feature Store)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ClickHouse Configuration (Historical Alert & Flow Store)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=threatlens
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# FastAPI Backend & WebSocket Gateway
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend (React + Vite Dashboard)
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/threats

# Detection Engine Parameters
ENGINE_WINDOW_SIZES_SEC=10,60,300
ENGINE_CONFIDENCE_THRESHOLD=0.65
